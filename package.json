{
  "name": "harnez",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b",
    "dev:server": "bun --watch apps/server/src/index.ts",
        "dev:client": "bun --watch apps/client/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
